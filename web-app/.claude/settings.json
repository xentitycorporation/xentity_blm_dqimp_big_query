{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(./tests/run_dashboard.bat *)",
      "PowerShell(& .\\tests\\run_dashboard.bat *)",
      "Read(Query_Results/mlrs_case_completeness/*.md)",
      "Read(Query_Results/mlrs_case_completeness/build_manifest.json)",
      "Read(Query_Results/mlrs_case_completeness/agent_logs/*.log)",
      "Read(Query_Results/mlrs_case_completeness/agent_history/*.json)",
      "Edit(Query_Results/mlrs_case_completeness/Dashboard_Update_Report_*.md)",
      "Skill(dashboard-update)"
    ],
    "deny": [
      "Bash(*--create*)", "PowerShell(*--create*)",
      "Bash(*run_dashboard.bat pin*)", "PowerShell(*run_dashboard.bat pin*)",
      "Bash(*run_dashboard.bat display*)", "PowerShell(*run_dashboard.bat display*)",
      "Bash(*dqimp_webapp*)", "PowerShell(*dqimp_webapp*)",
      "Bash(*verify_cert*)", "PowerShell(*verify_cert*)",
      "Bash(git *)", "PowerShell(git *)",
      "Read(tests/**)", "Edit(tests/**)",
      "Read(.claude/**)", "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Read(//**/*.csv)", "Edit(//**/*.csv)",
      "Read(~/.claude/**)", "Edit(~/.claude/**)",
      "Read(~/AppData/**)", "Edit(~/AppData/**)",
      "Read(~/.ssh/**)", "Read(~/.config/**)", "Read(~/.gitconfig)",
      "Bash(gh)", "Bash(gh *)", "PowerShell(gh)", "PowerShell(gh *)",
      "WebFetch", "WebSearch", "Agent", "NotebookEdit", "TaskStop", "Monitor",
      "EnterPlanMode", "ExitPlanMode", "Workflow",
      "mcp__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$LOCALAPPDATA/ESRI/conda/envs/arcgispro_clone/python.exe\" -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/dashboard_guard.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
